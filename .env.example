# Copy this file to .env and fill it in:  cp .env.example .env
# .env is ignored by git. Never commit it.

# --- Telegram API (from https://my.telegram.org -> API development tools) ---
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Where Telethon stores the login. Creates data/nerkhbot.session.
# Treat that file like a password.
TG_SESSION=data/nerkhbot

# Channels to collect, comma-separated. Any of these forms work:
#   @channelname   channelname   https://t.me/channelname
TG_CHANNELS=

# --- Collector behaviour ---
# On the very first run, how many days of history to fetch per channel (0 = all)
BACKFILL_DAYS=20
# How often (minutes) to re-check for missed posts
CATCHUP_MINUTES=15

# --- Storage & logging ---
DATABASE_URL=sqlite:///data/nerkhbot.db
LOG_LEVEL=INFO
LOG_DIR=logs
